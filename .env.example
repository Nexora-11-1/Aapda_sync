# ══════════════════════════════════════════════════════════════════════
# AapdaSync — copy to .env and fill in. Never commit .env.
#
# A source with no credential is NOT_CONFIGURED, which is a supported
# running state, not a failure: the platform runs without it, marks it in
# the UI, and reduces the confidence of predictions that needed it.
# ══════════════════════════════════════════════════════════════════════

# ── required ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
AAPDA_JWT_SECRET=generate-with-openssl-rand-base64-48

# ── deployment ────────────────────────────────────────────────────────
AAPDA_ENVIRONMENT=prod
POSTGRES_USER=aapda
POSTGRES_DB=aapdasync
API_PORT=8000
WEB_PORT=3000
PUBLIC_ORIGIN=https://aapdasync.example.gov.in
PUBLIC_API_URL=https://aapdasync.example.gov.in/api

# ── MVP scope (§29) ───────────────────────────────────────────────────
AAPDA_MVP_STATE_CODE=UT
AAPDA_MVP_DISTRICT_CODES=["UT-CHAMOLI","UT-RUDRAPRAYAG","UT-PAURI"]
AAPDA_MVP_HAZARDS=["flood","landslide"]
AAPDA_H3_RESOLUTION=7

# ══════════════════════════════════════════════════════════════════════
# PRIMARY SOURCES — Indian authorities
# See docs/10-data-sources.md. Leave blank until access is granted; the
# connector will report NOT_CONFIGURED rather than guess an endpoint.
# ══════════════════════════════════════════════════════════════════════

# IMD — register at https://api.imd.gov.in/ and whitelist this server's
# egress IP. Attribution to IMD is mandatory on every surface that shows
# its data.
IMD_API_KEY=
# JSON map of the endpoint paths IMD documents behind the portal login,
# e.g. {"station_observations":"/v1/...","district_warnings":"/v1/..."}
IMD_ENDPOINTS=

# NDMA SACHET — the CAP/RSS feed path published at
# https://sachet.ndma.gov.in/CapFeed
SACHET_FEED_PATH=

# CWC — the FFS portal (india-water.gov.in/ffs) is a dashboard, not a
# documented public API. Agree a machine-readable route with CWC/NWIC and
# set both values. Until then flood predictions run without river level
# and are flagged degraded.
CWC_API_KEY=
CWC_STATIONS_PATH=

# ISRO / NRSC Bhuvan — OGC WMS service path; a Bhuvan account is needed
# for the disaster-services layers.
NRSC_WMS_PATH=
NRSC_LAYER_PATTERNS=flood|inundat|landslide|lulc|water_body

# NCS — https://seismo.gov.in/data-portal registration
NCS_API_KEY=

# ══════════════════════════════════════════════════════════════════════
# SUPPLEMENTARY SOURCES — open, used only where a primary is silent and
# always stored under their own source key.
# ══════════════════════════════════════════════════════════════════════

# NASA FIRMS — free MAP_KEY from firms.modaps.eosdis.nasa.gov
FIRMS_MAP_KEY=
FIRMS_AREA=78.6,29.85,80.0,31.1

# OpenTopography — free key from portal.opentopography.org
OPENTOPO_API_KEY=

# WorldPop raster staged during provisioning (see scripts/provision.sh)
AAPDA_WORLDPOP_RASTER=/data/worldpop/ind_ppp_constrained.tif

# ── cadence ───────────────────────────────────────────────────────────
AAPDA_INFERENCE_INTERVAL_SECONDS=900
AAPDA_RISK_INTERVAL_SECONDS=900
AAPDA_QUALITY_INTERVAL_SECONDS=300

# ── model behaviour ───────────────────────────────────────────────────
AAPDA_ACTIVE_PRIORITY_WEIGHTS=v1
AAPDA_MIN_PREDICTION_CONFIDENCE=0.35
AAPDA_STALE_CONFIDENCE_PENALTY=0.45
